  "exports": "./uzbek-ste.ts",
  "files": ["uzbek-ste.ts", "README.md", "CHANGELOG.md", "LICENSE"],
  "omp": { "extensions": ["./uzbek-ste.ts"] },
  "engines": { "bun": ">=1.3.14" },
  "packageManager": "bun@1.4.2",
  "scripts": { "typecheck": "tsc --noEmit", "test": "bun test" },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.8.7",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
